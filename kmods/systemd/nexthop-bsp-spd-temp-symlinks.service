# Publishes /run/nexthop_bsp/sensors/DIMM[12]_TEMP for platform_manager, whose
# config cannot name the SPD hubs' kernel i2c bus number: it moves with the
# number of CPU I2C controllers the BIOS enables.
[Unit]
Description=Publish stable sysfs handles for DDR5 SPD temperature sensors
After=systemd-udevd.service
Before=platform_manager.service
ConditionPathExists=/sys/bus/i2c/drivers/spd5118

[Service]
Type=oneshot
ExecStart=/usr/libexec/nexthop_bsp/nh-spd-temp-symlinks.sh

[Install]
WantedBy=multi-user.target
